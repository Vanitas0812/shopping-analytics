# ============================================================
#  白名单方式：只提交项目核心代码与数据
# ============================================================
# 先忽略一切
/*
!/.gitignore
!/README.md
!/shopping-api/
!/dashboards/
!/data/

# ============================================================
#  在允许的目录内，进一步排除
# ============================================================

# --- 构建产物 ---
target/
out/
*.jar
*.class
*.war
*.original

# --- Python ---
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/

# --- 运行时日志 ---
*.log
app.err.log

# --- IDE 个人配置（保留 .idea 下的项目级配置）---
.idea/workspace.xml
.idea/httpRequests/
.idea/shelf/
*.iml

# --- 系统文件 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 临时测试与脚本 ---
_autotest.html
_syntax_check.js

# ============================================================
#  data 目录内的排除（只保留关键数据文件）
# ============================================================
/data/processed/*.csv
!/data/processed/session_cleaned.csv
/data/_*
